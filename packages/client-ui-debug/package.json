{
  "name": "@deepseek-ai/dsh-client-ui-debug",
  "description": "Composer Debug chip and dock that drive debug mode without slash commands",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "lib/index.js",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./src/client/index.ts",
      "default": "./lib/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "src"
  ],
  "license": "MIT",
  "dependencies": {
    "@deepseek-ai/dsh-debug-mode": "file:../debug-mode"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/dsh-api-gateway": "*",
    "@deepseek-ai/dsh-api-remotes": "*",
    "@deepseek-ai/dsh-client-locale": "*",
    "@deepseek-ai/dsh-client-store": "*",
    "@deepseek-ai/dsh-client-ui-conversation": "*",
    "@deepseek-ai/dsh-client-ui-primitives": "*",
    "@deepseek-ai/dsh-client-ui-renderer": "*",
    "@deepseek-ai/dsh-client-ui-slots": "*",
    "@deepseek-ai/dsh-session": "*",
    "@deepseek-ai/dsh-typert-protocol": "*"
  },
  "devDependencies": {
    "@types/react": "~18.3.1",
    "react": "^18.2.0",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  },
  "dsh": {
    "client": {
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-primitives",
        "@deepseek-ai/dsh-debug-mode",
        "@deepseek-ai/dsh-api-gateway"
      ],
      "platform": "web",
      "external": [
        "@deepseek-ai/dsh-api-gateway/client"
      ]
    }
  },
  "scripts": {
    "build": "node ../../scripts/bundle-client.mjs",
    "prepare": "node ../../scripts/bundle-client.mjs",
    "test": "vitest run --environment node"
  }
}
